# PayGuard backend — environment template. Copy to .env and fill in.
# DB URL (host port 5433 in dev: local postgresql-x64-18 service owns 5432)
DATABASE_URL=postgresql+asyncpg://payguard:payguard@localhost:5433/payguard

# Redis (cache, rate limits, pub/sub bridge)
REDIS_URL=redis://localhost:6379/0

# Celery broker + result backend (redis databases 1 and 2)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login rate limiting (attempts per minute)
LOGIN_RATE_LIMIT=5

# Offload risk analysis to the celery worker instead of running inline
ASYNC_ANALYSIS=false

# SMS interception allowlists (edit in code, not env)
# Known bank shortcodes: app/services/ingest/extractor.py → KNOWN_LEGIT_SHORTCODES
# Known legit domains:   app/models_ai/signal_scorer.py → KNOWN_LEGIT_DOMAINS

# AI models (leave empty to fall back to the rule engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
OPENROUTER_API_KEY=